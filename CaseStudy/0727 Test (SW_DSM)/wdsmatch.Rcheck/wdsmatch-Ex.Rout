> # Estimate PATE
> fit <- wdsmatchATE(Y = survey_obs$Y, X = survey_obs[, 3:8],
+                    Z = survey_obs$Z, weights = survey_obs$survey_weight,
+                    M = 3, varest = FALSE)
> fit

