    "unplanned_errors": "retain separately as infrastructure, source, baseline-pairing, or unexpected estimator errors; do not count them as evidence about the intended estimator",
    "resample_failed_datasets": false,
    "drop_failed_runs_from_denominator": false,
    "primary_full_performance_requires": 1000,
    "conditional_success_metrics": "optional separate explicitly labeled diagnostics with the paired sample count; never substitute for unconditional 1000-run relative bias",
    "rejection_frequency_status": "To be measured by the full five-replication-per-cell pilot and 1000-replication run; no rate inferred from positivity of observed weights."
  },
  "primary_performance": {
    "signed_relative_bias_percent": "100*(mean(estimate)-truth)/abs(truth)",
    "absolute_relative_bias_percent": "abs(signed_relative_bias_percent), not mean absolute replicate error",
    "absolute_relative_bias_reduction_pp": "absolute_relative_bias_original - absolute_relative_bias_stabilized; positive favors stabilization",
    "signed_relative_bias_difference_pp": "signed_relative_bias_stabilized - signed_relative_bias_original",
    "paired_signed_difference_mcse_pp": "100*sd(estimate_stabilized-estimate_original)/sqrt(N)/abs(truth)",
    "requires_complete_paired_run": true,
    "N": 1000
  },
  "mc_precision_for_absolute_bias_reduction": {
    "scope": "Monte Carlo precision of the simulation comparison, not causal-effect inference for an individual data set",
    "nominal_level": 0.95,
    "construction": "Bonferroni simultaneous t intervals for original and stabilized signed relative biases, then bound abs(original_bias)-abs(stabilized_bias)",
    "per_signed_bias_t_quantile": 0.9875,
    "degrees_of_freedom": "N-1",
    "signed_bias_mcse": "100*sd(estimate)/sqrt(N)/abs(truth)",
    "absolute_interval_transform": "min_abs([l,u])=0 if l<=0<=u, else min(abs(l),abs(u)); max_abs=max(abs(l),abs(u))",
    "reduction_lower": "min_abs(original signed-bias interval)-max_abs(stabilized signed-bias interval)",
    "reduction_upper": "max_abs(original signed-bias interval)-min_abs(stabilized signed-bias interval)",
    "interpretation": "conservative approximate Monte Carlo interval; avoids differentiating abs() at zero; not a Wald/percentile CI for stabilized treatment effects"
  },
