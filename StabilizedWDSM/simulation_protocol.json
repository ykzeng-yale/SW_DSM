  "original_point_adapter": {
    "call": "wdsm_final(..., B=2, bootstrap_counts=matrix(1,n,2), keep_point=TRUE)",
    "purpose": "Expose the official original point fit and match sets only.",
    "counts": "two deterministic all-one identity vectors, not multinomial draws",
    "retain": "original estimate, original point fit/matches, identity and PS diagnostics",
    "discard": [
      "artificial variance",
      "artificial SE",
      "artificial confidence limits",
      "artificial bootstrap estimates"
    ],
    "then_call": "wdsm_stabilized_from_fit(original,data=data,M=M,estimand=estimand,rho_degree=2)",
    "same_fit_self_normalized_tolerance": "1e-10*(1+abs(original_estimate))",
    "completed_baseline_comparison": "Check ordered sample IDs, population identity and the saved original WDSM point estimate separately; record actual numerical tolerance and difference. Never pair by row number alone."
  },
  "conditional_weight": {
    "rho_degree": 2,
    "basis": [
      "1",
      "psi",
      "psi^2",
      "p",
      "p^2",
      "p*psi"
    ],
    "regression": "unweighted least squares within each required observed arm",
    "response": "survey_weight/mean(all_sample_survey_weights)",
    "undo_response_scaling": true,
    "constant_arm_weights": "exact constant conditional-weight submodel",
    "required_prediction_domain": "all observations of each required observed arm, even if not selected as a donor",
    "acceptance": "finite and strictly positive predictions; full-rank finite coefficients",
    "implicit_positive_link": false,
    "clipping": false,
    "trimming": false,
    "fallback": false,
    "tuning_after_inspecting_bias": false,
    "theoretical_status": "Fixed quadratic is the frozen practical working model; it is not the shrinking-bandwidth kernel construction in the feasible-consistency theorem."
  },
  "stabilized_formula": {
    "missing_Yz": "m_z(D_i)+(1/M)*sum_j_in_Jz(i)[W_j/rho_z(D_j)*(Y_j-m_z(D_j))]",
    "rho_evaluation": "matched donor j, not target i",
    "residual": "entire residual is multiplied",
    "within_match_renormalization": false,
    "observed_outcomes": "unchanged",
    "outer_PATE": "weighted mean of imputed Y1-Y0 over all sampled observations",
    "outer_PATT": "weighted mean of Y-treated minus imputed Y0 over treated sampled observations"
  },
